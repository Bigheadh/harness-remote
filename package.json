{
  "name": "harness-remote",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Feishu task inbox for local Codex CLI, powered by MCP.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('src/server/dashboard/public','dist/server/dashboard/public',{recursive:true})\"",
    "server": "node dist/server/index.js",
    "mcp": "node dist/mcp-server/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:test": "tsc -p tsconfig.test.json --noEmit"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@fastify/compress": "^8.3.1",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "fastify": "^5.8.5",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
